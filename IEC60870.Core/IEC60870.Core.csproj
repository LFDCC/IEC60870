<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Authors>LFDCC</Authors>
    <Company>LFDCC</Company>
    <Copyright>Copyright 2026 LFDCC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>LFDCC.IEC60870.Core</PackageId>
