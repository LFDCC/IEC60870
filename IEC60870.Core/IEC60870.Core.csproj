<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Authors>LFDCC</Authors>
    <Company>LFDCC</Company>
    <Copyright>Copyright 2026 LFDCC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>LFDCC.IEC60870.Core</PackageId>
    <Version>5.2.1</Version>
    <RootNamespace>IEC60870.Core</RootNamespace>
    <AssemblyName>IEC60870.Core</AssemblyName>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>IEC 60870-5 shared application-layer primitives (ASDU, InformationObjects, time/quality types) for IEC 60870-5-101/104. Pure, transport-independent.</Description>
    <PackageOutputPath>nupkg</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- 生成 XML 文档：NuGet 包内随 dll 分发 .xml，消费方 IDE 才有中文 IntelliSense 提示 -->
    <!-- CS1591（公有成员缺注释）已按库现状抑制，避免海量噪声警告 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 源码按 SDK 默认通配编译（**/*.cs）：根/ 消息模型、Encoding/、Decoding/、TypeHandlers/、InformationObjects/、Quality/、Time/、File/ -->

</Project>
