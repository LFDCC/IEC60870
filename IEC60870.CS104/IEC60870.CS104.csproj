<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Authors>LFDCC</Authors>
    <Company>LFDCC</Company>
    <Copyright>Copyright 2026 LFDCC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>LFDCC.IEC60870.CS104</PackageId>
    <Version>5.2.0</Version>
    <RootNamespace>IEC60870.CS104</RootNamespace>
    <AssemblyName>IEC60870.CS104</AssemblyName>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>IEC 60870-5-104 protocol library (TCP/TCP-TLS transport, client/server) built on IEC60870.Core. Fully async, TouchSocket-based, zero-GC hot path.</Description>
    <PackageOutputPath>nupkg</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- 生成 XML 文档：NuGet 包内随 dll 分发 .xml，消费方 IDE 才有中文 IntelliSense 提示 -->
    <!-- CS1591（公有成员缺注释）已按库现状抑制，避免海量噪声警告 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 源码按 SDK 默认通配编译（**/*.cs）：Connection/ 状态机层、Adapter/ 解析管线、根/ 公共 API，新增文件无需维护清单 -->
  <ItemGroup>
    <ProjectReference Include="..\IEC60870.Core\IEC60870.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="tests-cs104" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TouchSocket" Version="4.3.2" />
  </ItemGroup>

</Project>
