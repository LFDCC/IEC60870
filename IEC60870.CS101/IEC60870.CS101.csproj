<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Authors>LFDCC</Authors>
    <Company>LFDCC</Company>
    <Copyright>Copyright 2026 LFDCC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>LFDCC.IEC60870.CS101</PackageId>
    <Version>5.2.0</Version>
    <RootNamespace>IEC60870.CS101</RootNamespace>
    <AssemblyName>IEC60870.CS101</AssemblyName>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>IEC 60870-5-101 protocol library (balanced/unbalanced link layer, serial and TCP transport, client/server) built on IEC60870.Core.</Description>
    <PackageOutputPath>nupkg</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- 源码按 SDK 默认通配编译（**/*.cs）：LinkLayer/ 链路层、File/ 文件服务、根/ 站点组件，新增文件无需维护清单 -->
  <ItemGroup>
    <ProjectReference Include="..\IEC60870.Core\IEC60870.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TouchSocket" Version="4.3.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
